# Copy this file to .env and replace the values with your own.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit the real .env file to GitHub.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- MariaDB database ---
DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (console backend prints emails to the terminal) ---
DEFAULT_FROM_EMAIL=noreply@news.local

# --- Internal approval API (/api/approved/) ---
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-internal-key

